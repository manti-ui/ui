{
  "name": "manti-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm build:ladle",
    "build:packages": "pnpm --filter @manti-ui/tokens build && pnpm --filter @manti-ui/styles build && pnpm --filter @manti-ui/folds build && pnpm --filter @manti-ui/react build && pnpm --filter @manti-ui/oklava build",
    "build:ladle": "ladle build",
    "dev": "pnpm build:packages && pnpm ladle",
    "docs:dev": "pnpm build:packages && vite packages/docs",
    "docs:build": "pnpm build:packages && pnpm --filter @manti-ui/docs build",
    "docs:preview": "vite preview packages/docs",
    "build:site": "pnpm docs:build && pnpm build:ladle && rm -rf packages/docs/dist/ladle && cp -r ladle-static packages/docs/dist/ladle",
    "gen:tokens": "pnpm --filter @manti-ui/styles gen:tokens",
    "gen:tokens:check": "pnpm --filter @manti-ui/styles gen:tokens:check",
    "gen:presets": "pnpm --filter @manti-ui/styles gen:presets",
    "gen:presets:check": "pnpm --filter @manti-ui/styles gen:presets:check",
    "gen:variant-ink": "pnpm --filter @manti-ui/styles gen:variant-ink",
    "check:color-scale": "pnpm --filter @manti-ui/styles check:color-scale",
    "check:exports": "node scripts/check-react-exports.mjs",
    "check:types": "node scripts/check-consumer-types.mjs",
    "report:variant-ink": "pnpm --filter @manti-ui/styles report:variant-ink",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "ladle": "ladle serve -p 61000",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.ladle.json --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:exports && pnpm test && pnpm build && pnpm check:types"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.0",
    "@kampus/fabrika-cli": "0.10.0",
    "@ladle/react": "5.1.1",
    "@manti-ui/styles": "workspace:*",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
