{
  "name": "@manti-ui/styles",
  "version": "1.0.0",
  "description": "Framework-agnostic CSS for Manti UI.",
  "license": "MIT",
  "homepage": "https://manti.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manti-ui/ui.git",
    "directory": "packages/styles"
  },
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "tailwind",
    "ui"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": {
      "development": "./src/index.css",
      "default": "./dist/index.css"
    },
    "./tokens.css": {
      "development": "./src/tokens.css",
      "default": "./dist/tokens.css"
    },
    "./tailwind.css": {
      "development": "./src/tailwind.css",
      "default": "./dist/tailwind.css"
    },
    "./tailwind-theme.css": {
      "development": "./src/tailwind-theme.css",
      "default": "./dist/tailwind-theme.css"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./index.css": "./dist/index.css",
      "./tokens.css": "./dist/tokens.css",
      "./tailwind.css": "./dist/tailwind.css",
      "./tailwind-theme.css": "./dist/tailwind-theme.css"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens-css.mjs",
    "gen:tokens:check": "node scripts/gen-tokens-css.mjs --check",
    "gen:variant-ink": "node scripts/gen-variant-ink.mjs",
    "gen:variant-ink:check": "node scripts/gen-variant-ink.mjs --check",
    "report:variant-ink": "node scripts/gen-variant-ink.mjs --report",
    "check:component-tokens": "node scripts/check-component-tokens.mjs",
    "check:color-scale": "node scripts/check-color-scale.mjs",
    "gen:component-tokens-doc": "node scripts/gen-component-tokens-doc.mjs",
    "build": "node scripts/gen-tokens-css.mjs --check && node scripts/check-component-tokens.mjs && node scripts/check-color-scale.mjs && node scripts/gen-variant-ink.mjs --check && node scripts/check-contrast.mjs --gate && node scripts/gen-component-tokens-doc.mjs --check && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@manti-ui/tokens": "workspace:^"
  },
  "devDependencies": {
    "colorjs.io": "^0.7.1"
  }
}
